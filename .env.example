APP_ENV=local
APP_DEBUG=true

POSTGRES_USER=blog_user
POSTGRES_PASSWORD=blog_password
POSTGRES_DB=blog_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://blog_user:blog_password@db:5432/blog_db
ALEMBIC_DATABASE_URL=postgresql+asyncpg://blog_user:blog_password@db:5432/blog_db


RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio_user
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=blog-images
S3_REGION=us-east-1

JWT_SECRET_KEY=super-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@example.com
